# --- Обязательные
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Пароль для входа в дашборд (Basic auth: логин любой) и для POST /api/sync/run
DASHBOARD_TOKEN=demo-dashboard-token

# --- Режим Bitrix24: mock (встроенный эмулятор) | live (реальный портал)
BITRIX_MODE=mock
# Входящий вебхук портала, нужен только для live. Пример: https://example.bitrix24.ru/rest/1/abc123xyz/
BITRIX_WEBHOOK_URL=

# --- Синхронизация
SYNC_INTERVAL_MIN=5
PORT=3000
NODE_ENV=development

# --- Необязательные (значения по умолчанию)
# LOG_LEVEL=info
# APP_TZ=Europe/Moscow
# SYNC_ON_START=true
# SYNC_CURSOR_OVERLAP_SEC=120
# CACHE_TTL_SEC=60
# BITRIX_RATE_LIMIT_RPS=2
# BITRIX_BATCH_PAGES=50
# Маппинг портала на модель дашборда (см. README, раздел «Переключение на реальный Bitrix24»)
# BITRIX_SEGMENT_FIELD=UF_CRM_SEGMENT
# BITRIX_LEAD_VERTICAL_FIELD=CATEGORY_ID
# BITRIX_LEAD_VERTICALS=1:dental,2:metal
# BITRIX_CATEGORY_VERTICALS=1:dental,2:metal
# BITRIX_DEPARTMENT_VERTICALS=10:dental,20:metal
# BITRIX_DEFAULT_VERTICAL=dental
# BITRIX_STAGE_MAP={"UC_CALLBACK":"IN_PROGRESS","C3:CONTRACT":"MEETING"}
# ADS_ENABLED=true
# Токены mock-эндпоинтов (на публичном деплое задайте случайные значения)
# MOCK_WEBHOOK_TOKEN=mock-webhook-secret
# ADS_API_TOKEN=mock-ads-secret
